FROM node:20-alpine AS deps

WORKDIR /repo

COPY package.json package-lock.json ./
COPY apps/gateway/package.json apps/gateway/

RUN npm ci -w gateway

FROM node:20-alpine AS builder

WORKDIR /repo

COPY --from=deps /repo/node_modules ./node_modules
COPY --from=deps /repo/apps/gateway/node_modules ./apps/gateway/node_modules
COPY package.json package-lock.json ./
COPY apps/gateway ./apps/gateway

WORKDIR /repo/apps/gateway

RUN npm run build

FROM node:20-alpine AS runner

WORKDIR /repo

ENV NODE_ENV=production

COPY package.json package-lock.json ./
COPY apps/gateway/package.json apps/gateway/

RUN npm ci -w gateway --omit=dev

COPY --from=builder /repo/apps/gateway/dist ./apps/gateway/dist

WORKDIR /repo/apps/gateway

CMD ["node", "dist/main.js"]

{
	"$schema": "https://turbo.build/schema.json",
	"globalEnv": [
		"REDIRECT_URI",
		"CLIENT_ID",
		"CLIENT_SECRET",
		"WEBAPP_URL",
		"NEXT_PUBLIC_API_URL",
		"GATEWAY_HOST",
		"GATEWAY_PORT",
		"AUTH_SERVICE_HOST",
		"AUTH_SERVICE_PORT",
		"USER_SERVICE_HOST",
		"USER_SERVICE_PORT",
		"PROJECT_SERVICE_HOST",
		"PROJECT_SERVICE_PORT",
		"COMMENTS_SERVICE_HOST",
		"COMMENTS_SERVICE_PORT",
		"S3_ENDPOINT",
		"S3_KEY",
		"S3_SECRET",
		"S3_BUCKET",
		"S3_REGION",
		"JWT_PRIVATE_KEY_PATH",
		"JWT_PUBLIC_KEY_PATH",
		"JWT_KID",
		"JWT_ISSUER",
		"JWT_AUDIENCE",
		"MAIL_USERNAME",
		"MAIL_CLIENT_ID",
		"MAIL_SECRET",
		"MAIL_REFRESH_TOKEN",
		"MAIL_FROM",
		"SMTP_HOST",
		"SMTP_PORT",
		"SMTP_USER",
		"SMTP_PASS",
		"SMTP_SECURE"
	],
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"outputs": ["dist/**", ".next/**", "!.next/cache/**"]
		},
		"dev": {
			"cache": false,
			"persistent": true
		},
		"lint": {
			"dependsOn": ["^lint"]
		}
	}
}

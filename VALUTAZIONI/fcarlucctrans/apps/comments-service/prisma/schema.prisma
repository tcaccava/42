// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider     = "prisma-client-js"

  // Alright, for some reason custom output paths have stopped working for me.
  // Thus I will be using default ones from now on (essentially the same way the
  // `auth-service` does this.) I'm not sure what are the implications of doing this though.
//  output       = "../prisma/client"
  moduleFormat = "cjs"
  importFileExtension = "js"
}

datasource db {
  provider = "sqlite"
}

model User {
  id       String       @id
  name     String
  comments Comment[]
}

model Comment {
  id          Int      @id @default(autoincrement())
  user        User     @relation(fields: [userId], references: [id])
  userId      String
  commentText String
  projectId   Int
  createdAt   DateTime @default(now())
  // The `@updatedAt` is a built-in Prisma feature, that allows you to track the
  // time of the last update of the table row, which is handy af.
  updatedAt   DateTime @updatedAt
}
